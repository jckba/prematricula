includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: 5
    paths:
        - app
        - database
        - routes
        - bootstrap/app.php
        - config
    tmpDir: storage/framework/cache/phpstan
    treatPhpDocTypesAsCertain: false
    parseModelCastsMethod: true
