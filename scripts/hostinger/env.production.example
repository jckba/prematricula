# Plantilla de producción para Hostinger. En el Administrador de archivos:
# renombrar este archivo a .env y completar los valores marcados con CAMBIAR.
APP_NAME=Prematricula
APP_ENV=production
# CAMBIAR: pegar la clave de build/hostinger/app-key.txt (empieza por base64:).
APP_KEY=
APP_DEBUG=false
# CAMBIAR: dirección pública con https, sin barra final.
APP_URL=https://CAMBIAR.example

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# CAMBIAR: datos de hPanel > Bases de datos > Administración (MySQL/MariaDB).
# En Hostinger el host es "localhost" y el nombre y el usuario llevan el prefijo uXXXXXXX_.
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uXXXXXXX_prematricula
DB_USERNAME=uXXXXXXX_prematricula
DB_PASSWORD=
DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log

ACADEMIC_TIMEZONE=America/Lima
ACADEMIC_LEGACY_TIMEZONE=UTC
INSTITUTION_UNIVERSITY="Universidad Nacional de Trujillo"
INSTITUTION_SCHOOL=
# CAMBIAR: igual que APP_URL.
CORS_ALLOWED_ORIGINS=https://CAMBIAR.example
