# Copiar a .env.testing. La suite solo acepta MariaDB/MySQL con la base
# exactamente llamada prematricula_test y la borra/recrea en cada ejecución:
# nunca la apuntes a una base con datos útiles.
APP_ENV=testing
APP_KEY=
APP_DEBUG=false

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prematricula_test
DB_USERNAME=prematricula_test
DB_PASSWORD=testing_only
DB_URL=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
