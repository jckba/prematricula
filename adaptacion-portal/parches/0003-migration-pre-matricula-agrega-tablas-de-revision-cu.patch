diff --git a/app/Modules/PreMatricula/Database/Migrations/2026_11_18_000003_create_revisiones_solicitud_table.php b/app/Modules/PreMatricula/Database/Migrations/2026_11_18_000003_create_revisiones_solicitud_table.php
