+{
+    protected $table = 'prematricula.revision_curso';
+
+    protected $primaryKey = 'id_revision';
+
+    public $incrementing = false;
+
+    public $timestamps = false;
+
+    protected $fillable = [
+        'id_revision',
+        'id_curso_plan',
+        'preferencia_turno',
+    ];
